JEICHAT_BOT_TOKEN=jei_live_your_token_here
JEICHAT_API_URL=http://localhost:3001
JEICHAT_WEB_ORIGIN=http://localhost:3000

# Fixer bot userId from GET /bots/@me on the fixer process (optional)
# FIXER_BOT_USER_ID=

CURSOR_API_KEY=cursor_your_key_here
CURSOR_RUNTIME=cloud
CURSOR_REPO_URL=https://github.com/jpmadrigal07/jeichat
CURSOR_REPO_REF=main
CURSOR_MODEL=composer-2.5

# Cursor Dashboard → Cloud → Environments (DATABASE_URL, REVIEWER_TEST_EMAIL, …)
# CURSOR_CLOUD_ENVIRONMENT=jpmadrigal07/jeichat

# Post verification PNGs from a Cursor run to the ticket thread (default on)
# REVIEWER_POST_SCREENSHOTS=true
